<Window x:Class="GeniaProxy.BrowserIntegrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Интеграция с браузером"
        Width="700"
        Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#071521"
        Foreground="#F2F7FA"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="125" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#0B2530" />
            <Setter Property="Foreground" Value="#F2F7FA" />
            <Setter Property="BorderBrush" Value="#28D9C5" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Browser Integration / Direct Bridge Stable"
                   FontSize="19"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="1"
                   Margin="0,7,0,16"
                   Foreground="#9CADB8"
                   TextWrapping="Wrap"
                   Text="GeniaProxy.exe сам публикует read-only состояние на 127.0.0.1. Отдельный GeniaProxy.NativeHost.exe, Native Messaging manifest и привязка к одному Extension ID не используются." />

        <Border Grid.Row="2"
                Padding="12"
                Margin="0,0,0,14"
                Background="#0B1E2C"
                BorderBrush="#315365"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Состояние" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="#9EDDD6" />
                <TextBlock x:Name="StatusDetailsText"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="#9CADB8"
                           FontSize="11" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="0,0,0,14">
            <Button Content="Открыть папку Switcher"
                    MinWidth="190"
                    Click="OpenSwitcherFolderButton_Click" />
            <Button Content="Обновить статус"
                    Click="RefreshButton_Click" />
        </StackPanel>

        <Border Grid.Row="4"
                Padding="12"
                Background="#081A26"
                BorderBrush="#274757"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Как подключить Switcher Direct"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,7,0,0"
                           Foreground="#9CADB8"
                           TextWrapping="Wrap">
                    <Run Text="1. Нажмите «Открыть папку Switcher». Откроется browser-integration рядом с текущим GeniaProxy.exe." />
                    <LineBreak />
                    <Run Text="2. В Chrome откройте chrome://extensions, включите режим разработчика и загрузите папку Genia-Proxy-Switcher." />
                    <LineBreak />
                    <Run Text="3. Никакой Extension ID вводить в GeniaProxy не нужно. Каждый профиль Chrome обращается к встроенному read-only Direct Bridge независимо." />
                    <LineBreak />
                    <Run Text="4. Switcher независимо проверяет browser exit через Cloudflare и использует тот же fail-closed TUN Transition Guard." />
                </TextBlock>
                <TextBlock Margin="0,10,0,0"
                           Foreground="#D7B66D"
                           TextWrapping="Wrap"
                           Text="Stable: Direct Bridge слушает только 127.0.0.1 и принимает только GET/OPTIONS. Управлять VPN, профилями или запускать команды через него нельзя." />
            </StackPanel>
        </Border>

        <Button Grid.Row="5"
                Content="Закрыть"
                HorizontalAlignment="Right"
                MinWidth="100"
                IsCancel="True"
                Margin="0,14,0,0" />
    </Grid>
</Window>

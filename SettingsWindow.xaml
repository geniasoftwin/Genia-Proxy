<Window x:Class="GeniaProxy.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки GeniaProxy"
        Width="560"
        Height="505"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#071521"
        Foreground="#F2F7FA"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F2F7FA" />
            <Setter Property="Margin" Value="0,0,0,15" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="#EFFFFD" />
            <Setter Property="Background" Value="#0B2530" />
            <Setter Property="BorderBrush" Value="#28D9C5" />
            <Setter Property="Padding" Value="12,6" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#123744" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#18505B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Поведение программы"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,18" />

        <CheckBox x:Name="AutoConnectCheckBox"
                  Grid.Row="1"
                  Content="Подключаться автоматически при запуске" />

        <CheckBox x:Name="StartWithWindowsCheckBox"
                  Grid.Row="2"
                  Content="Запускать GeniaProxy вместе с Windows" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="ReconnectCheckBox"
                      Content="Переподключаться после неожиданного сбоя ядра"
                      Checked="ReconnectCheckBox_Changed"
                      Unchecked="ReconnectCheckBox_Changed" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Задержка, сек."
                           Foreground="#9CADB8"
                           VerticalAlignment="Center"
                           Margin="0,0,8,15" />
                <TextBox x:Name="ReconnectDelayTextBox"
                         Width="55"
                         Height="29"
                         Margin="0,0,0,15"
                         TextAlignment="Center"
                         MaxLength="2"
                         Background="#06131D"
                         Foreground="#F2F7FA"
                         BorderBrush="#315365" />
            </StackPanel>
        </Grid>

        <CheckBox x:Name="CollapseLogCheckBox"
                  Grid.Row="4"
                  Content="Запускать программу со скрытым журналом" />

        <Grid Grid.Row="5" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Ядро профиля"
                       VerticalAlignment="Center" />
            <ComboBox x:Name="CorePreferenceComboBox"
                      Grid.Column="1"
                      Height="30"
                      SelectedIndex="0">
                <ComboBoxItem Content="Автоматически" />
                <ComboBoxItem Content="sing-box" />
                <ComboBoxItem Content="Xray" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="6" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Стек TUN для профиля"
                       VerticalAlignment="Center" />
            <ComboBox x:Name="TunStackComboBox"
                      Grid.Column="1"
                      Height="30"
                      SelectedIndex="0">
                <ComboBoxItem Content="mixed (рекомендуется)" />
                <ComboBoxItem Content="system" />
                <ComboBoxItem Content="gVisor" />
            </ComboBox>
        </Grid>

        <TextBlock Grid.Row="7"
                   Text="Для максимальной защиты сетевого трафика используйте TUN. Ядро и стек TUN сохраняются отдельно для выбранного профиля; mixed использует системный TCP и gVisor UDP."
                   TextWrapping="Wrap"
                   Foreground="#9CADB8"
                   Margin="0,4,0,0" />

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Отмена" IsCancel="True" />
            <Button Content="Сохранить"
                    IsDefault="True"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>

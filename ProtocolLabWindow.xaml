<Window x:Class="GeniaProxy.ProtocolLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeniaProxy · Protocol Lab"
        Width="980"
        Height="700"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#071521"
        Foreground="#F2F7FA"
        FontFamily="Segoe UI"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#0B1E2C" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#365A6D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#28D9C5" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9CADB8" />

        <Style x:Key="LabCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="LabButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Foreground" Value="#EFFFFD" />
            <Setter Property="Background" Value="#0B2530" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="LabTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#06131D" />
            <Setter Property="Foreground" Value="#F2F7FA" />
            <Setter Property="BorderBrush" Value="#315365" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style x:Key="LabPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#06131D" />
            <Setter Property="Foreground" Value="#F2F7FA" />
            <Setter Property="BorderBrush" Value="#315365" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PROTOCOL LAB"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="GeniaProxy 4.5.0 Alpha 3 · isolated local-proxy runner"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11" />
            </StackPanel>
            <Border Grid.Column="1"
                    Background="#173240"
                    BorderBrush="#365A6D"
                    BorderThickness="1"
                    Padding="9,4"
                    VerticalAlignment="Center">
                <TextBlock Text="DISABLED BY DEFAULT"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#9EDDD6" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,14,0,12"
                Padding="12"
                Background="#241D12"
                BorderBrush="#9D7A35"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="ЭКСПЕРИМЕНТАЛЬНЫЙ РЕЖИМ"
                           FontWeight="Bold"
                           Foreground="#E5C07B" />
                <TextBlock Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           Foreground="#D7C8A6"
                           Text="Protocol Lab работает только как loopback local-proxy. Он не включает системный proxy, не управляет Windows routes/DNS и не запускается одновременно со stable-сессией GeniaProxy." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.12*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.88*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="CapabilityList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource LabCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Grid.Column="0"
                                                 Width="22"
                                                 VerticalAlignment="Center"
                                                 GroupName="ProtocolLabCapability"
                                                 IsEnabled="{Binding Selectable}"
                                                 Tag="{Binding Id}"
                                                 Checked="Capability_Checked" />

                                    <StackPanel Grid.Column="1" Margin="9,0,14,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text=" · "
                                                       Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="{Binding EngineLabel}"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}"
                                                   Margin="0,5,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="#7F96A3"
                                                   FontSize="11" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SupportLabel}"
                                                   Foreground="{Binding SupportColor}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Id}"
                                                   Margin="0,4,0,0"
                                                   Foreground="#5F7886"
                                                   FontSize="10"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Column="2"
                    Style="{StaticResource LabCardStyle}"
                    Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ConnectionInputsPanel"
                                IsEnabled="False">
                        <TextBlock Text="LAB SESSION"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="Сервер"
                                   Margin="0,12,0,4"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" />
                        <TextBox x:Name="ServerTextBox"
                                 Style="{StaticResource LabTextBoxStyle}"
                                 MaxLength="255" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Порт сервера"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" />
                                <TextBox x:Name="ServerPortTextBox"
                                         Style="{StaticResource LabTextBoxStyle}"
                                         Text="443"
                                         MaxLength="5"
                                         Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Локальный порт"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" />
                                <TextBox x:Name="LocalPortTextBox"
                                         Style="{StaticResource LabTextBoxStyle}"
                                         Text="2088"
                                         MaxLength="5"
                                         Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="SecretLabel"
                                   Text="Пароль"
                                   Margin="0,10,0,4"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" />
                        <PasswordBox x:Name="SecretPasswordBox"
                                     Style="{StaticResource LabPasswordBoxStyle}"
                                     MaxLength="4096" />

                        <StackPanel x:Name="TuicUuidPanel"
                                    Visibility="Collapsed">
                            <TextBlock Text="TUIC UUID"
                                       Margin="0,10,0,4"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" />
                            <TextBox x:Name="TuicUuidTextBox"
                                     Style="{StaticResource LabTextBoxStyle}"
                                     MaxLength="36" />
                        </StackPanel>

                        <StackPanel x:Name="TlsServerNamePanel">
                            <TextBlock Text="TLS server name (SNI)"
                                       Margin="0,10,0,4"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" />
                            <TextBox x:Name="TlsServerNameTextBox"
                                     Style="{StaticResource LabTextBoxStyle}"
                                     MaxLength="255" />
                            <TextBlock Text="Если пусто — используется адрес сервера. TLS verification остаётся включённой."
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#6F8795"
                                       FontSize="10" />
                        </StackPanel>

                        <Border Height="1"
                                Background="#274757"
                                Margin="0,14,0,12" />

                        <TextBlock Text="Статус"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" />
                        <TextBlock x:Name="LabStatusText"
                                   Text="Остановлено"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="LabEndpointText"
                                   Text="loopback не активен"
                                   Margin="0,4,0,0"
                                   Foreground="#7F96A3"
                                   FontSize="10" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Выбрано"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10" />
                <TextBlock x:Name="SelectedCapabilityText"
                           Text="Ничего — Lab выключен"
                           Margin="0,3,0,0"
                           FontSize="13"
                           FontWeight="SemiBold" />
            </StackPanel>

            <Button Grid.Column="1"
                    x:Name="LabStartButton"
                    Style="{StaticResource LabButtonStyle}"
                    IsEnabled="False"
                    Content="ЗАПУСТИТЬ LAB"
                    Click="LabStartButton_Click"
                    ToolTip="Запускает только изолированный loopback local-proxy Protocol Lab." />
        </Grid>
    </Grid>
</Window>
